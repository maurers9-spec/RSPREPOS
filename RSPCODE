
import java.util.Scanner;

class RockPaperScissorsLizardSpock {
    public static void main(String[] args) {
        Scanner keyboard = new Scanner(System.in);
        String playAgain = "yes";

        while (playAgain.equalsIgnoreCase("yes")) {
            System.out.println("Choose rock, paper, scissors, lizard, or spock:");
            String playerChoice = keyboard.nextLine();

            // Check for a valid choice
            while (!playerChoice.equalsIgnoreCase("rock") &&
                   !playerChoice.equalsIgnoreCase("paper") &&
                   !playerChoice.equalsIgnoreCase("scissors") &&
                   !playerChoice.equalsIgnoreCase("lizard") &&
                   !playerChoice.equalsIgnoreCase("spock")) {
                System.out.println("Invalid choice. Please try again:");
                playerChoice = keyboard.nextLine();
            }

            // Generate the computer's choice
            int randomNumber = (int) (Math.random() * 5) + 1;
            String computerChoice = "";

            if (randomNumber == 1) {
                computerChoice = "rock";
            } else if (randomNumber == 2) {
                computerChoice = "paper";
            } else if (randomNumber == 3) {
                computerChoice = "scissors";
            } else if (randomNumber == 4) {
                computerChoice = "lizard";
            } else {
                computerChoice = "spock";
            }

            System.out.println("You chose: " + playerChoice);
            System.out.println("Computer chose: " + computerChoice);

            // Determine who wins
            if (playerChoice.equalsIgnoreCase(computerChoice)) {
                System.out.println("It's a draw!");
            } else if (playerChoice.equalsIgnoreCase("rock") &&
                       (computerChoice.equals("scissors") || computerChoice.equals("lizard"))) {
                System.out.println("You win!");
            } else if (playerChoice.equalsIgnoreCase("paper") &&
                       (computerChoice.equals("rock") || computerChoice.equals("spock"))) {
                System.out.println("You win!");
            } else if (playerChoice.equalsIgnoreCase("scissors") &&
                       (computerChoice.equals("paper") || computerChoice.equals("lizard"))) {
                System.out.println("You win!");
            } else if (playerChoice.equalsIgnoreCase("lizard") &&
                       (computerChoice.equals("paper") || computerChoice.equals("spock"))) {
                System.out.println("You win!");
            } else if (playerChoice.equalsIgnoreCase("spock") &&
                       (computerChoice.equals("rock") || computerChoice.equals("scissors"))) {
                System.out.println("You win!");
            } else {
                System.out.println("You lose!");
            }

            System.out.println("Do you want to play again? (yes/no)");
            playAgain = keyboard.nextLine();
        }

        System.out.println("Thanks for playing!");
        keyboard.close();
    }
}
